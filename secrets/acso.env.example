# Copy to acso.env and fill in. Never commit acso.env.
# Load: set -a && source secrets/acso.env && set +a  (bash/zsh)

# Legacy production WordPress (read-only for automation)
OLD_WP_URL=https://samoorg.com.ua
OLD_WP_ADMIN_URL=
OLD_WP_USER=
OLD_WP_APP_PASSWORD=

# SSH (same host for prod/staging on shared hosting)
SSH_HOST=
SSH_USER=
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_PORT=22

# Staging subdomain (writes OK here only)
STAGING_WP_URL=
STAGING_WP_ADMIN_URL=
STAGING_DOCROOT=
# Relative to cPanel home, e.g. staging.samoorg.com.ua (NOT /staging... at filesystem root)
STAGING_WP_USER=
STAGING_WP_APP_PASSWORD=

# cPanel
CPANEL_URL=
CPANEL_USER=
CPANEL_PASSWORD=
# UAPI token for MCP (scripts/mcp-cpanel-wrapper.sh) — NOT the login password
CPANEL_API_TOKEN=
# Optional if CPANEL_URL is empty:
# CPANEL_HOST=skm352.hostsila.org
# CPANEL_PORT=2083

# Hostpro billing (optional)
HOSTPRO_BILLING_URL=
HOSTPRO_BILLING_EMAIL=
HOSTPRO_BILLING_PASSWORD=

# Staging MySQL (empty DB for new WP — create in cPanel MySQL Wizard, not phpMyAdmin)
STAGING_DB_NAME=
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_HOST=localhost
